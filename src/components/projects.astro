---
import { Image } from "astro:assets";
import svgl from "../../public/svgl.png";
import Prism from "../../public/prism.png";
import Sonch from "../../public/sonch.png";
import bucket from "../../public/bucket.png";
import Mealy from "../../public/mealy.jpg";
import Pipeline from "../../public/pipeline.png";
import Naukri from "../../public/naukri.png";
import Trackhub from "../../public/trackhub.png";
import ProjectCard from "../React/ProjectCard";
import FuzzyText from "../React/FuzzyText";
const hoverIntensity = 0.5;
const enableHover = true;

interface Project {
  title: string;
  image?: ImageMetadata;
  imageSrc?: string;
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Test Generation Pipeline",
    image: Pipeline as ImageMetadata,
    link: "https://github.com/aaayushh7/TestGeneration-execution-pipeline",
    preview: "https://github.com/aaayushh7/TestGeneration-execution-pipeline",
    status: "Developed",
  },
  {
    title: "Naukri Profile Automation",
    image: Naukri as ImageMetadata,
    link: "https://github.com/aaayushh7/naukri-profile-automation",
    preview: "https://github.com/aaayushh7/naukri-profile-automation",
    status: "Developed",
  },
  {
    title: "Mealy",
    image: Mealy as ImageMetadata,
    link: "https://github.com/aaayushh7/Mealy-",
    preview: "https://mealy-a7.vercel.app",
    status: "Developed",
  },
  {
    title: "Trackhub",
    image: Trackhub as ImageMetadata,
    link: "https://github.com/gothsec/stockin-demo",
    preview: "https://trackhub-at.vercel.app",
    status: "Developed",
  },
  {
    title: "Bucket (web,Android,Ios)",
    image: bucket as ImageMetadata,
    link: "https://github.com/aaayushh7/GD-frontend",
    preview: "https://cravehub.store/",
    status: "On Development",
  },
  {
    title: "Anomaly Detection of Smart home",
    image: Prism as ImageMetadata,
    link: "https://github.com/aaayushh7/AnomalyPrism-frontend",
    preview: "https://anomaly-prism-frontend.vercel.app/",
    status: "Developed",
  },
  {
    title: "Sonch",
    image: Sonch as ImageMetadata,
    link: "https://github.com/aaayushh7/projectSonch",
    preview: "https://project-sonch-5buctavxw-aaayushh7s-projects.vercel.app/",
    status: "Developed",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <div class="mb-8">
      <FuzzyText 
        client:only="react"
        baseIntensity={0.2} 
        hoverIntensity={hoverIntensity} 
        enableHover={enableHover}
        fontSize="2.5rem"
        color="#ffffff"
        text="Projects"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <ProjectCard client:only {...project} />
      ))}
    </div>

    <a
      target="_blank"
      href="https://github.com/aaayushh7?tab=repositories"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
